# SIH26083 Backend Configuration

# Set to true to automatically run the background weather scheduler
WEATHER_SCHEDULER_ENABLED=true

# Wait time in seconds between background collection loops (default: 900 / 15m)
WEATHER_COLLECTION_INTERVAL=900

# Open-Meteo URL (default works without an API key)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Allow connections from frontend dev servers (React/Vite)
DEV_CORS_ENABLED=true
